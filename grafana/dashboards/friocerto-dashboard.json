{
  "uid": "friocerto-temperaturas",
  "title": "FrioCerto — Monitoramento das 14 lojas",
  "tags": [
    "IoT",
    "FrioCerto",
    "AF12"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Temperatura por loja (°C) — últimos 15 min",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "friocerto-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "friocerto-influx"
          },
          "query": "from(bucket: \"sensores\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"temperatura_camara\" and r._field == \"temp_c\")\n  |> group(columns: [\"loja\"])\n  |> yield(name: \"temperaturas\")",
          "rawQuery": true
        }
      ],
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": false
          },
          "displayName": "${__field.labels.loja}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
}
